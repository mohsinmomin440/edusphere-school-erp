{
  "name": "edusphere",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:api",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm-run-all --parallel build:web build:api",
    "build:web": "npm --workspace apps/web run build",
    "build:api": "npm --workspace apps/api run build",
    "lint": "npm-run-all --parallel lint:web lint:api",
    "lint:web": "npm --workspace apps/web run lint",
    "lint:api": "npm --workspace apps/api run lint",
    "type-check": "npm-run-all --parallel type:web type:api",
    "type:web": "npm --workspace apps/web run type-check",
    "type:api": "npm --workspace apps/api run type-check",
    "test": "npm-run-all --parallel test:web test:api",
    "test:web": "npm --workspace apps/web run test",
    "test:api": "npm --workspace apps/api run test"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
